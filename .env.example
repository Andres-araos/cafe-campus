# Copia este archivo como .env y pon los valores de tu proyecto de Supabase
# (Project Settings → API). La clave publicable es segura en el navegador:
# la protección real está en las políticas RLS y en las funciones de la base de datos.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
